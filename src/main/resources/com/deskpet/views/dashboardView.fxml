<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Pane?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.deskpet.controllers.DashboardController">
    <children>
        <Label layoutX="270.0" layoutY="27.0" text="Dashboard" />

        <Button text="Settings" onAction="#openSettings"/>

        <Label fx:id="activePetLabel"
               layoutX="200.0"
               layoutY="60.0"
               prefWidth="200.0"
               alignment="CENTER"
               text="No Pet Loaded" />

        <Label layoutX="67.0" layoutY="68.0" text="Happiness" />
        <ProgressBar fx:id="happinessBar" layoutX="67.0" layoutY="85.0" prefHeight="20.0" prefWidth="467.0" progress="1.0" />
        <Label layoutX="67.0" layoutY="117.0" text="Hunger" />
        <ProgressBar fx:id="comfortBar" layoutX="321.0" layoutY="134.0" prefHeight="20.0" prefWidth="213.0" progress="1.0" />
        <Label layoutX="321.0" layoutY="117.0" text="Comfort" />
        <ProgressBar fx:id="hungerBar" layoutX="67.0" layoutY="134.0" prefHeight="20.0" prefWidth="213.0" progress="1.0" />
        <Label layoutX="67.0" layoutY="170.0" text="Social" />
        <ProgressBar fx:id="socialBar" layoutX="67.0" layoutY="187.0" prefHeight="20.0" prefWidth="213.0" progress="1.0" />
      <Label layoutX="67.0" layoutY="224.0" text="Favourite food: " />
      <Label fx:id="favouriteFoodLabel" layoutX="152.0" layoutY="224.0" prefHeight="17.0" prefWidth="33.0" text="N/A" />
      <ListView fx:id="foodStatsListView" layoutX="67.0" layoutY="275.0" prefHeight="95.0" prefWidth="213.0" />
      <Label layoutX="67.0" layoutY="258.0" text="Food eaten" />
      <Label layoutX="321.0" layoutY="170.0" text="Feeding log" />
      <ListView fx:id="feedingHistoryListView" layoutX="321.0" layoutY="187.0" prefHeight="182.0" prefWidth="213.0" />

        <!-- Movement historical data -->
        <Label layoutX="67.0" layoutY="270.0" text="Last movement detected" />
        <Label fx:id="lastMovement" layoutX="250.0" layoutY="270.0" text="No data"/>
    </children>
</Pane>