<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.deskpet.controllers.SettingsController"
      spacing="12"
      prefWidth="420"
      prefHeight="500">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Pet Management"/>

    <ComboBox fx:id="petComboBox"
              promptText="Choose a pet"
              prefWidth="250"/>

    <Button text="Load Selected Pet"
            onAction="#loadSelectedPet"/>

    <Separator/>

    <Label text="Create A New Pet"/>
    <TextField fx:id="newPetNameField"
               promptText="Pet name"/>

    <Button text="Create Pet"
            onAction="#createPet"/>

    <Separator/>

    <Label text="Food Preferences"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Liked food:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="likedFoodComboBox"
                  promptText="Choose liked food"
                  prefWidth="160"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="1"/>
        <Label fx:id="currentLikedFoodLabel"
               GridPane.rowIndex="0"
               GridPane.columnIndex="2"/>

        <Label text="Disliked food:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="dislikedFoodComboBox"
                  promptText="Choose disliked food"
                  prefWidth="160"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1"/>
        <Label fx:id="currentDislikedFoodLabel"
               GridPane.rowIndex="1"
               GridPane.columnIndex="2"/>
    </GridPane>

    <Button text="Save Food Preferences"
            onAction="#saveFoodPreferences"/>

    <Separator/>

    <Label text="Environment Settings"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Temp min:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tempMinField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="currentTempMinLabel" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="Temp max:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="tempMaxField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="currentTempMaxLabel" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <Label text="Humidity min:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="humidityMinField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label fx:id="currentHumidityMinLabel" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

        <Label text="Humidity max:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="humidityMaxField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label fx:id="currentHumidityMaxLabel" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

        <Label text="Noise min:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="noiseMinField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label fx:id="currentNoiseMinLabel" GridPane.rowIndex="4" GridPane.columnIndex="2"/>

        <Label text="Noise max:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="noiseMaxField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label fx:id="currentNoiseMaxLabel" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
    </GridPane>

    <Button text="Save Settings"
            onAction="#saveSettings"/>

    <Label fx:id="messageLabel" text=""/>

</VBox>